<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./components/head'); %>
    <link rel="stylesheet" href="./css/index.css">
    <link rel="stylesheet" href="./css/instrument-details.css">
    <title>YShop</title>
</head>
<body>
    <%- include('./components/header'); %>
    <main>
        <div class="instrument-container">
            <div class="instrument-image-container">
                <button class="arrow-btn arrow-left">&#10094;</button>
                <img class="instrument-image" src="" alt="instrument-image">
                <button class="arrow-btn arrow-right">&#10095;</button>
            </div>
            
            <div class="details">
                <div class="upper-details-container">
                    <div class="left-upper-container">
                        <h1 class="name-placeholder"></h1>
                        <p class="category-placeholder"></p>
                    </div>

                    <div class="right-upper-container">
                        <div class="favorite-container">
                        </div>                        
                    </div>
                    
                </div>
                <div class="desc-container">
                    <p class="desc-placeholder"></p>
                    <p class="expand-btn">Afficher plus</p>
                </div>
                <div class="lower-details-container">
                    <div class="images-container">
                        <img class='instrument-images-other' src="">
                        <img class='instrument-images-other' src="">
                    </div>

                    <div class="right-lower-container">
                        <h2 class="price-placeholder"></h2>
                        <p class="quantity-placeholder"></p>
                        <h3 class="add-to-basket">Ajouter au panier</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="similaire">
            <div class="h2"><h2>Produit(s) similaire(s) :</h2></div>
            <div class="zone_simi">
                
            </div>
        </div>

        <div class="plaire">
            <div class="h2_plaire"><h2>Produits qui pourraient vous plaire :</h2></div>
            <div class="zone_plaire">
                
            </div>
        </div>
    
        <!-- TEST TOAST -->
        <div class="cart-toast">
            <p class="toast-text">Produit ajouté au panier ! 🛒</p>
            <div class="cart-toast__buttons">
                <button class="c-cta-button">Voir le panier</button>
            </div>
        </div>
    </main>
    <script src="./scripts/search.js"></script>
    <script src="./scripts/instrument-details_script.js"></script>
</body>
</html>