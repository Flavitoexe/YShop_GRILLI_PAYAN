<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./components/head'); %>
    <link rel="stylesheet" href="./css/index.css">
</head>
<body>
    <%- include('./components/header'); %>
    <main>
        <div class="carousel-container">
            <div class="title">
                <h1>Nouveautés</h1>
            </div>

            <div class="carousel">
                <div class="inner-carousel"></div>

                <div class="carousel-dots"></div>
            </div>
        </div>

        <div class="categories-container">
            <div class="title">
                <h1>Catégories</h1>
            </div>

            <div class="categories">
                <div class="category">
                    <img class="category-logo" src="../img/guitares-s/4_4_gold_1.jpg" alt="strings-category-logo" >
                    <h2>Instruments à cordes</h2>
                </div>
                <div class="category">
                    <img class="category-logo" src="../img/trompettes/sib_cuivre_1.jpg" alt="brass-category-logo" >
                    <h2>Cuivres</h2>
                </div>
                <div class="category">
                    <img class="category-logo" src="../img/batteries/pearl_export_noire_1.jpg" alt="percussions-category-logo" >
                    <h2>Percussions</h2>
                </div>
            </div>
        </div>
    </main>
    <script src="./script.js"></script>
</body>
</html>